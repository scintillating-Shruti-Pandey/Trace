# ==============================================================================
# TRACE CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================
# In local development mode with Docker Compose, core services (database, redis)
# are automatically configured. Copy this file to .env only if you need overrides.
#
# POLICY NOTE ON API KEYS:
# Trace is designed for ZERO monetary cost ($0.00). In the default local mode,
# embeddings and visual encoding run on the host GPU (RTX 4050 6 GB) via local
# microservices on ports 8001 and 8002. No paid API keys are required.
# ==============================================================================

# --- Database & Infrastructure ---
DATABASE_URL=postgresql+psycopg://trace:trace@localhost:5432/trace
REDIS_URL=redis://localhost:6379/0

# --- Feature Flags ---
SEARCH_ENABLED=true
INGEST_ENABLED=false

# --- Local GPU Model Microservices ($0.00 Spend, Zero API Keys Required) ---
# Port 8001: BAAI/bge-m3 dense 1024-d text embedding microservice (python scripts/serve_embeddings.py --port 8001)
EMBEDDING_ENDPOINT=http://localhost:8001/v1/embeddings

# Port 8002: google/siglip2-so400m-patch14-384 1152-d visual microservice (python scripts/serve_visual.py --port 8002)
VISUAL_ENDPOINT=http://localhost:8002/v1/visual

# --- Optional Hosted Fallback (Only needed if host GPU is unavailable) ---
# Leave empty for pure free local inference.
DEEPINFRA_API_KEY=
EMBEDDING_API_KEY=

# --- Storage & Media (Deferred in base profile) ---
BLOB_ENDPOINT=http://localhost:9000
BLOB_BUCKET=trace
BLOB_ACCESS_KEY=trace-local
BLOB_SECRET_KEY=trace-local-development
INCOMING_DIR=./data/incoming
FFPROBE_BIN=ffprobe
